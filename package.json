{
  "name": "address-atlas",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "description": "Encrypted sync server for the Address Atlas native macOS crypto portfolio app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sync:db:up": "docker compose -f compose.sync.yml up -d",
    "sync:db:down": "docker compose -f compose.sync.yml down",
    "sync:prod:up": "bash server/sync/manage-prod.sh up",
    "sync:prod:down": "bash server/sync/manage-prod.sh down",
    "sync:prod:volume": "bash server/sync/manage-prod.sh detect-volumes",
    "sync:schema:bootstrap": "tsx src/lib/sync/bootstrap.ts",
    "sync:backup": "bash server/sync/manage-prod.sh backup",
    "sync:backup:verify": "bash server/sync/manage-prod.sh verify-backup",
    "sync:restore:drill": "bash server/sync/manage-prod.sh restore-drill",
    "sync:restore:production": "bash server/sync/manage-prod.sh restore",
    "sync:restore:bootstrap": "bash server/sync/manage-prod.sh bootstrap-restore",
    "sync:monitor": "bash server/sync/monitor-sync.sh",
    "memory:init": "python3 scripts/repo-memory.py init",
    "memory:add": "python3 scripts/repo-memory.py add",
    "memory:sync": "python3 scripts/repo-memory.py sync",
    "memory:search": "python3 scripts/repo-memory.py search",
    "memory:reindex": "python3 scripts/repo-memory.py reindex",
    "memory:doctor": "python3 scripts/repo-memory.py doctor",
    "typecheck": "tsc --noEmit",
    "native:test": "cd native/AddressAtlasMac && swift test",
    "native:test:tsan": "cd native/AddressAtlasMac && swift test --sanitize=thread",
    "native:dmg": "cd native/AddressAtlasMac && ./build-dmg.sh",
    "native:notarize": "cd native/AddressAtlasMac && ./notarize-mac-app.sh",
    "release:doctor": "./scripts/release-doctor.sh",
    "ops:test": "bash server/sync/ops-script-tests.sh",
    "test": "vitest run"
  },
  "keywords": [
    "crypto",
    "portfolio",
    "wallet",
    "bitcoin",
    "ethereum",
    "cosmos",
    "read-only"
  ],
  "author": "Omer Girgin",
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tldts": "7.4.9"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.13",
    "vite": "8.1.4"
  }
}
