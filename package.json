{
  "name": "address-atlas",
  "version": "0.1.0",
  "private": false,
  "description": "Read-only multi-chain crypto portfolio tracker from pasted wallet addresses.",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "node scripts/ensure-sqlite-db.mjs && prisma db push",
    "db:generate": "prisma generate",
    "clean:local-dupes": "node scripts/clean-local-duplicates.mjs",
    "sync:db:up": "docker compose -f compose.sync.yml up -d",
    "sync:db:down": "docker compose -f compose.sync.yml down",
    "sync:prod:up": "docker compose --env-file server/sync/.env.production -f server/sync/compose.prod.yml up -d --build",
    "sync:prod:down": "docker compose --env-file server/sync/.env.production -f server/sync/compose.prod.yml down",
    "typecheck": "prisma generate && node scripts/clean-local-duplicates.mjs && tsc --noEmit",
    "native:test": "cd native/AddressAtlasMac && swift test",
    "native:dmg": "cd native/AddressAtlasMac && ./build-dmg.sh",
    "native:notarize": "cd native/AddressAtlasMac && ./notarize-mac-app.sh",
    "release:doctor": "./scripts/release-doctor.sh",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "crypto",
    "portfolio",
    "wallet",
    "bitcoin",
    "ethereum",
    "cosmos",
    "read-only"
  ],
  "author": "Omer Girgin",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "better-sqlite3": "^12.9.0",
    "ccxt": "^4.5.51",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "protobufjs": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.59.1",
    "prisma": "^7.8.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
