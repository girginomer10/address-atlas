# Encrypted sync server for the Address Atlas native macOS app. The server is
# sync-only: it stores opaque encrypted vault snapshots and never sees plaintext.
ADDRESS_ATLAS_SYNC_ONLY="true"
SYNC_DATABASE_URL="postgres://address_atlas:address_atlas@localhost:15432/address_atlas_sync"
SYNC_SESSION_SECRET="replace-with-a-long-random-secret"
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="Address Atlas"
PASSKEY_ORIGIN="http://localhost:3000"
