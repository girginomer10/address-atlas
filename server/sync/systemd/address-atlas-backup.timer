[Unit]
Description=Run Address Atlas encrypted backup at least every six hours

[Timer]
# Five-hour calendar slots leave enough margin for the randomized delay: the
# longest scheduled activation gap is 5h15m, below the six-hour RPO target.
OnCalendar=*-*-* 00,05,10,15,20:15:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=address-atlas-backup.service

[Install]
WantedBy=timers.target
