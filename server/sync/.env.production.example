ADDRESS_ATLAS_DOMAIN=sync.address-atlas.example
ACME_EMAIL=ops@example.com
# Volume names are auto-discovered. Set an override only after the deployment
# helper reports ambiguous or unrecognized candidates and you have identified
# the authoritative existing volume. On a confirmed new installation where
# every reported candidate belongs to another stack, the documented stable name
# explicitly acknowledges that a new volume may be created. Never guess during
# an upgrade.
# ADDRESS_ATLAS_POSTGRES_VOLUME=address-atlas-prod-postgres
# ADDRESS_ATLAS_CADDY_DATA_VOLUME=address-atlas-caddy-data
# ADDRESS_ATLAS_CADDY_CONFIG_VOLUME=address-atlas-caddy-config
# Backups stream through age without writing plaintext. Keep identity/signing
# files outside this repository. Private files must be operator-owned 0600; the
# public verification key must not be group/other-writable.
ADDRESS_ATLAS_BACKUP_DIR=/var/backups/address-atlas
ADDRESS_ATLAS_BACKUP_RETENTION_DAYS=30
ADDRESS_ATLAS_BACKUP_MAX_AGE_HOURS=8
# Reject unexpectedly large local or retrieved artifacts before they can fill
# the recovery filesystem. Raise this 50 GiB ceiling only after capacity review.
ADDRESS_ATLAS_BACKUP_MAX_BYTES=53687091200
ADDRESS_ATLAS_BACKUP_AGE_RECIPIENT=age1replace-with-the-public-recipient
ADDRESS_ATLAS_BACKUP_AGE_IDENTITY_FILE=/root/.config/address-atlas/backup.agekey
ADDRESS_ATLAS_BACKUP_SIGNING_PRIVATE_KEY_FILE=/root/.config/address-atlas/backup-signing-private.pem
ADDRESS_ATLAS_BACKUP_SIGNATURE_PUBLIC_KEY_FILE=/root/.config/address-atlas/backup-signing-public.pem
# A root-owned executable must upload all four supplied paths to separately
# controlled immutable storage. Production strict checks require this contract.
ADDRESS_ATLAS_BACKUP_OFFSITE_REQUIRED=true
ADDRESS_ATLAS_BACKUP_OFFSITE_HOOK=/root/.config/address-atlas/upload-backup-set
# Durable, owner-only deployment receipt. Prepare its parent with:
# install -d -m 0700 /var/lib/address-atlas
ADDRESS_ATLAS_NATIVE_CONFIG_STATE_FILE=/var/lib/address-atlas/native-config-deployment.json
# Crash-resumable first-install journal and private read-only Git source cache.
# Keep these exact defaults when using the supplied hardened systemd units.
ADDRESS_ATLAS_INSTALL_STATE_FILE=/var/lib/address-atlas/install-deployment.json
ADDRESS_ATLAS_DEPLOY_SOURCE_ROOT=/var/lib/address-atlas/deploy-sources
# Compose enforces conservative memory and PID ceilings so an edge/application
# exhaustion event cannot consume the whole database host. Override only from
# measured production high-water marks with alert thresholds below the limit.
# ADDRESS_ATLAS_CADDY_MEMORY_LIMIT=256m
# ADDRESS_ATLAS_CADDY_MEMORY_RESERVATION=64m
# ADDRESS_ATLAS_WEB_MEMORY_LIMIT=1g
# ADDRESS_ATLAS_WEB_MEMORY_RESERVATION=256m
# ADDRESS_ATLAS_ADMIN_MEMORY_LIMIT=768m
# ADDRESS_ATLAS_ADMIN_MEMORY_RESERVATION=128m
# ADDRESS_ATLAS_DB_ADMIN_MEMORY_LIMIT=256m
# ADDRESS_ATLAS_DB_ADMIN_MEMORY_RESERVATION=64m
# ADDRESS_ATLAS_POSTGRES_MEMORY_LIMIT=2g
# ADDRESS_ATLAS_POSTGRES_MEMORY_RESERVATION=512m
# Generate three independent URL-safe values with `openssl rand -hex 32`.
# Use bootstrap exactly once for a new/legacy cluster, then change to steady.
# Strict release checks reject bootstrap mode. Steady provisioning never
# receives POSTGRES_PASSWORD and cannot fall back when admin authentication fails.
ADDRESS_ATLAS_DATABASE_ROLE_MODE=bootstrap
# POSTGRES_PASSWORD belongs only to the demoted schema/object owner.
# POSTGRES_RUNTIME_PASSWORD belongs to the long-running DML-only web role.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-long-random-admin-password
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-long-random-runtime-password
SYNC_SCHEMA_DATABASE_URL=postgres://address_atlas:replace-with-the-owner-postgres-password@postgres:5432/address_atlas_sync
SYNC_DATABASE_URL=postgres://address_atlas_runtime:replace-with-the-runtime-postgres-password@postgres:5432/address_atlas_sync
# Generate with: openssl rand -base64 48
SYNC_SESSION_SECRET=replace-with-at-least-32-random-bytes
SYNC_MAX_ACCOUNTS=100000
# Closed by default in production. Open only during an intentional enrollment
# window; durable hourly admission control still applies while enabled.
SYNC_REGISTRATION_ENABLED=false
SYNC_REGISTRATION_HOURLY_LIMIT=100
SYNC_VAULT_DAILY_WRITE_LIMIT=100
# Counts every authenticated PUT body, including rejected stale/invalid writes.
SYNC_VAULT_DAILY_BYTE_LIMIT=64000000
# Aggregate daily ingress budget across all accounts (2 GB).
SYNC_GLOBAL_VAULT_DAILY_INGRESS_BYTE_LIMIT=2000000000
# Aggregate encrypted snapshot storage ceiling across every account (10 GB).
SYNC_GLOBAL_VAULT_STORAGE_LIMIT=10000000000
SYNC_DB_POOL_SIZE=10
SYNC_DB_CONNECT_TIMEOUT_MS=5000
SYNC_DB_IDLE_TIMEOUT_MS=30000
SYNC_DB_STATEMENT_TIMEOUT_MS=10000
SYNC_DB_QUERY_TIMEOUT_MS=12000
PASSKEY_RP_ID=sync.address-atlas.example
PASSKEY_RP_NAME=Address Atlas
# PASSKEY_ORIGIN is intentionally derived from ADDRESS_ATLAS_DOMAIN by Compose.
NATIVE_ENDPOINT_CONFIG_VERSION=5
NATIVE_ENDPOINT_CONFIG_UPDATED_AT=2026-07-14T00:00:00.000Z
NATIVE_ENDPOINT_MIN_APP_VERSION=0.2.0
# Optional operator notice served through /config/native and displayed as a
# banner inside the Mac app. Leave unset outside maintenance/advisory windows.
# NATIVE_ENDPOINT_CONFIG_MESSAGE=Scheduled maintenance tonight 02:00-03:00 UTC.
# Optional public price/chain endpoint override for /config/native.
# Exchange hosts and request paths are deliberately fixed inside the Mac app.
# NATIVE_ENDPOINT_CONFIG_JSON={"configVersion":5,"chains":{"ethereum":{"rpcUrl":"https://ethereum-rpc.publicnode.com"}}}
